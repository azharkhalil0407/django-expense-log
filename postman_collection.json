{
  "info": {
    "name": "Expense Tracker API",
    "description": "Collection covering all endpoints of the Expense Tracker API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "auth_token",
      "value": "8f838e7a0fa67392210fefaab40fb0166d7a0435"
    }
  ],
  "item": [
    {
      "name": "List Categories",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Token {{auth_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/categories/",
          "host": ["{{base_url}}"],
          "path": ["api", "categories", ""]
        },
        "description": "Returns all categories for the authenticated user."
      }
    },
    {
      "name": "Create Category",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Token {{auth_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Groceries\",\n  \"description\": \"Food and household supplies\",\n  \"monthly_limit\": \"500.00\",\n  \"is_favorite\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/categories/",
          "host": ["{{base_url}}"],
          "path": ["api", "categories", ""]
        },
        "description": "Creates a new category with optional monthly_limit and is_favorite fields."
      }
    },
    {
      "name": "Create Category (with monthly budget)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Token {{auth_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dining\",\n  \"description\": \"Restaurants and takeout\",\n  \"monthly_limit\": \"200.00\",\n  \"is_favorite\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/categories/",
          "host": ["{{base_url}}"],
          "path": ["api", "categories", ""]
        },
        "description": "Creates a category with a monthly budget limit. Exceeding it triggers a Discord bot alert."
      }
    },
    {
      "name": "List Expenses",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Token {{auth_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/expenses/?start_date=2026-01-01&end_date=2026-12-31",
          "host": ["{{base_url}}"],
          "path": ["api", "expenses", ""],
          "query": [
            { "key": "start_date", "value": "2026-01-01" },
            { "key": "end_date", "value": "2026-12-31" }
          ]
        },
        "description": "Lists all expenses for the authenticated user. Optionally filter by start_date and end_date (YYYY-MM-DD)."
      }
    },
    {
      "name": "Create Expense",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Token {{auth_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Weekly shop\",\n  \"amount\": \"54.20\",\n  \"currency\": \"USD\",\n  \"category\": 1,\n  \"date\": \"2026-06-09\",\n  \"notes\": \"Supermarket run\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/expenses/",
          "host": ["{{base_url}}"],
          "path": ["api", "expenses", ""]
        },
        "description": "Creates a new expense. Triggers budget alert if category monthly limit is exceeded."
      }
    },
    {
      "name": "Create Expense (with currency)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Token {{auth_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Hotel in Paris\",\n  \"amount\": \"120.00\",\n  \"currency\": \"EUR\",\n  \"category\": 1,\n  \"date\": \"2026-06-09\",\n  \"notes\": \"Two nights\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/expenses/",
          "host": ["{{base_url}}"],
          "path": ["api", "expenses", ""]
        },
        "description": "Creates an expense in a non-base currency. The summary endpoint converts it to BASE_CURRENCY."
      }
    },
    {
      "name": "Retrieve Expense",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Token {{auth_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/expenses/1/",
          "host": ["{{base_url}}"],
          "path": ["api", "expenses", "1", ""]
        },
        "description": "Retrieves a single expense by id."
      }
    },
    {
      "name": "Update Expense",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Token {{auth_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Weekly shop (updated)\",\n  \"amount\": \"60.00\",\n  \"currency\": \"USD\",\n  \"category\": 1,\n  \"date\": \"2026-06-09\",\n  \"notes\": \"Adjusted total\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/expenses/1/",
          "host": ["{{base_url}}"],
          "path": ["api", "expenses", "1", ""]
        },
        "description": "Updates an existing expense by id."
      }
    },
    {
      "name": "Delete Expense",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Token {{auth_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/expenses/1/",
          "host": ["{{base_url}}"],
          "path": ["api", "expenses", "1", ""]
        },
        "description": "Deletes an expense by id."
      }
    },
    {
      "name": "Expense Summary",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Token {{auth_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/expenses/summary/",
          "host": ["{{base_url}}"],
          "path": ["api", "expenses", "summary", ""]
        },
        "description": "Returns total spent per category with currency conversion to BASE_CURRENCY."
      }
    },
    {
      "name": "Monthly Summary",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Token {{auth_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/expenses/monthly-summary/",
          "host": ["{{base_url}}"],
          "path": ["api", "expenses", "monthly-summary", ""]
        },
        "description": "Returns total spending grouped by month."
      }
    }
  ]
}